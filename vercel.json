{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "striatalabs.co.za" }],
      "destination": "https://www.striatalabs.co.za/:path*",
      "permanent": true
    },
    { "source": "/learn/bpc-157-recovery-peptide-guide", "destination": "/learn/bpc-157-south-africa", "permanent": true },
    { "source": "/learn/how-to-build-a-peptide-recovery-protocol", "destination": "/learn/peptides-for-south-african-athletes", "permanent": true },
    { "source": "/learn/glow-stack-peptides-skin-regeneration", "destination": "/learn/ghk-cu-copper-peptide-anti-aging", "permanent": true },
    { "source": "/learn/nad-plus-brain-health-focus-mental-clarity", "destination": "/learn/nad-plus-aging-decline-what-to-do", "permanent": true },
    { "source": "/learn/glp-1-peptides-explained", "destination": "/learn/semaglutide-vs-tirzepatide-vs-retatrutide", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*).js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(.*).css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/opt/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
